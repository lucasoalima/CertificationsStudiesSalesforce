# Provider padrão: anthropic | ollama
QGEN_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Embeddings: hashing (offline, sem dependências) | ollama | st (sentence-transformers)
QGEN_EMBEDDER=hashing
OLLAMA_EMBED_MODEL=nomic-embed-text
ST_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking, retrieval e filtros de qualidade
QGEN_CHUNK_CHARS=900
QGEN_CHUNK_OVERLAP=150
QGEN_TOP_K=6
QGEN_MIN_GROUNDING=0.6
QGEN_DUP_THRESHOLD=0.88
